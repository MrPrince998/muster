NODE_ENV=development
PORT=5001

# Postgres container (docker compose reads these for the db service)
POSTGRES_USER=muster
POSTGRES_PASSWORD=change-me
POSTGRES_DB=muster

# The app connects as a limited role: no DDL, subject to row-level security.
# `pnpm migration:run` creates/updates this role with this exact password.
# Host is "db" inside Docker; use "localhost" when running on your machine.
DATABASE_URL=postgresql://muster_app:change-me-too@db:5432/muster

# The schema owner (POSTGRES_USER above), used only by migrations.
MIGRATION_DATABASE_URL=postgresql://muster:change-me@db:5432/muster

JWT_SECRET=change-me
JWT_EXPIRES_IN=1h

# Signs the QR tickets. Separate from JWT_SECRET on purpose. Any long random
# string, e.g. the output of: openssl rand -base64 32
TICKET_SECRET=change-me-too

# The frontend; links in emails point here.
APP_URL=http://localhost:3000

# Leave RESEND_API_KEY empty in development: emails are printed to the backend
# log instead of sent. Required in production.
RESEND_API_KEY=
# onboarding@resend.dev works without verifying a domain, but only delivers to
# the address that owns your Resend account.
EMAIL_FROM=Campus Pass <onboarding@resend.dev>

# API docs at /docs. Defaults to on outside production.
# SWAGGER_ENABLED=true
