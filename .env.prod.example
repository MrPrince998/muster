# Copy to .env.prod (never committed) and fill in. Used by compose.prod.yaml.
# Passwords and secrets: letters and digits only, so they're safe inside the
# database URLs. Generate each with: openssl rand -hex 32

# Two subdomains of ONE domain you own, both pointing at this server.
# They must share a domain: the sign-in cookie is only sent within one site.
APP_DOMAIN=app.example.org
API_DOMAIN=api.example.org

# The database's owner (runs migrations) and the app's limited role
POSTGRES_USER=muster
POSTGRES_PASSWORD=
POSTGRES_DB=muster
APP_DB_PASSWORD=

# Sign sign-ins and tickets: at least 32 characters each, and different
JWT_SECRET=
TICKET_SECRET=

# Email (resend.com): an API key, and a sender on a domain verified there
RESEND_API_KEY=
EMAIL_FROM=Muster <hello@example.org>

# Paid tickets through Stripe Connect (optional; leave empty to keep every event free).
# Keys from dashboard.stripe.com/apikeys; the webhook secret from a webhook endpoint at
# https://<API_DOMAIN>/payments/webhook sending checkout.session.completed,
# checkout.session.expired and account.updated.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Muster's share of each ticket, in percent
PLATFORM_FEE_PERCENT=0

# The time zone event times are written in, in emails (IANA name)
APP_TIME_ZONE=Australia/Sydney

# Optional: where "Send feedback" goes; leave empty to hide the button
FEEDBACK_EMAIL=
